<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Today" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#FF14121F</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- System splash (Android 12+ native, older versions via core-splashscreen): just the app
         background. The logo is drawn by the in-app intro from the user's current outfit, which a
         static theme drawable can't know. -->
    <style name="Theme.Today.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#FF14121F</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
        <item name="postSplashScreenTheme">@style/Theme.Today</item>
    </style>
</resources>
